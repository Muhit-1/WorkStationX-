<Window x:Class="WorkStationX.Views.ScreenRulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen ruler"
        Width="440" Height="180"
        MinWidth="120" MinHeight="80"
        WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False"
        Topmost="True" ResizeMode="CanResizeWithGrip"
        Background="#22000000">

    <Border BorderBrush="{DynamicResource Brush.Prime}" BorderThickness="1">
        <Grid>
            <!-- crosshair through the middle, so an edge can be lined up exactly -->
            <Line X1="0" Y1="0" X2="0" Y2="0" x:Name="HLine" Stroke="{DynamicResource Brush.LampOn}"
                  StrokeThickness="1" StrokeDashArray="4 4" Opacity="0.8" />
            <Line X1="0" Y1="0" X2="0" Y2="0" x:Name="VLine" Stroke="{DynamicResource Brush.LampOn}"
                  StrokeThickness="1" StrokeDashArray="4 4" Opacity="0.8" />

            <Border Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.EdgeHi}" BorderThickness="1"
                    Padding="14,11" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="OnDragHandle" Cursor="SizeAll">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="SizeText" Text="0 × 0"
                                   FontFamily="{StaticResource Font.Mono}" FontSize="21"
                                   Foreground="{DynamicResource Brush.Phos}" />
                        <TextBlock Text="px" Margin="6,0,0,0" VerticalAlignment="Bottom"
                                   Style="{StaticResource Text.Mono}" />
                    </StackPanel>
                    <TextBlock x:Name="ScaleText" Text="" Margin="0,4,0,0"
                               HorizontalAlignment="Center" Style="{StaticResource Text.Mono}" />
                    <TextBlock Text="Drag to move · edges to resize · Esc to close"
                               Margin="0,6,0,0" HorizontalAlignment="Center"
                               Style="{StaticResource Text.EngravedSmall}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
