<Window x:Class="WorkStationX.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WorkStationX.ViewModels"
        xmlns:views="clr-namespace:WorkStationX.Views"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        Title="WorkStationX"
        Height="720" Width="1120"
        MinHeight="520" MinWidth="880"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- View-model to view mapping. Pages are selected by type, so no
             view-model ever needs to know about a View class. -->
        <DataTemplate DataType="{x:Type vm:WorkspaceViewModel}">
            <views:WorkspaceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TaskViewModel}">
            <views:TaskView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToolsViewModel}">
            <views:ToolsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="WorkStationX"
                        NoLeftClickDelay="True" />

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="WorkStationX"
                           FontSize="18" FontWeight="SemiBold"
                           Margin="20,24,20,20" />

                <ItemsControl ItemsSource="{Binding Pages}" Margin="8,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}"
                                    HorizontalContentAlignment="Left"
                                    Padding="14,10"
                                    Margin="0,2"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    Command="{Binding DataContext.NavigateCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Content area -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
    </Grid>
</Window>
