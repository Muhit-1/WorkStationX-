<Window x:Class="WorkStationX.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:WorkStationX.ViewModels"
        xmlns:views="clr-namespace:WorkStationX.Views"
        Title="WorkStationX"
        Height="840" Width="1320"
        MinHeight="680" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Shell}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!-- Custom chrome. CaptionHeight keeps drag, snap and double-click-to-maximise
         working for free; only the buttons are ours. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <!-- A maximised WindowChrome window overhangs the screen edges; this margin
         pulls it back. Swapped by the trigger below. -->
    <Border x:Name="Root" BorderBrush="{DynamicResource Brush.EdgeWindow}" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Margin" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="Maximized">
                        <Setter Property="Margin" Value="7" />
                        <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- ==================== titlebar ==================== -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.Titlebar}"
                    BorderBrush="{DynamicResource Brush.EdgeFaint}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock VerticalAlignment="Center" Margin="16,0,0,0"
                               FontFamily="{StaticResource Font.Cond}" FontWeight="Bold"
                               FontSize="13" Foreground="{DynamicResource Brush.Engrave}">
                        <TextBlock.Text>
                            <Binding Path="Brand" FallbackValue="WORKSTATIONX" />
                        </TextBlock.Text>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource Button.Window}" Width="Auto" Padding="14,0"
                                Margin="0,0,10,0" Command="{Binding ShowHistoryCommand}"
                                ToolTip="Daily and weekly history"
                                AutomationProperties.Name="History">
                            <TextBlock Style="{StaticResource Text.Engraved}" FontSize="12"
                                       Foreground="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=Button}}">
                                <TextBlock.Text>
                                    <Binding Path="IsOnHistory">
                                        <Binding.Converter>
                                            <views:BoolToTextConverter TrueText="BENCH"
                                                                       FalseText="HISTORY" />
                                        </Binding.Converter>
                                    </Binding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource Button.Window}" Width="Auto" Padding="14,0"
                                Command="{Binding ShowSettingsCommand}"
                                ToolTip="Settings" AutomationProperties.Name="Settings">
                            <TextBlock Style="{StaticResource Text.Engraved}" FontSize="12"
                                       Foreground="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=Button}}">
                                <TextBlock.Text>
                                    <Binding Path="IsOnSettings">
                                        <Binding.Converter>
                                            <views:BoolToTextConverter TrueText="BENCH"
                                                                       FalseText="SETTINGS" />
                                        </Binding.Converter>
                                    </Binding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Button>
                        <!-- Separator so the nav pair does not read as part of the window controls. -->
                        <Rectangle Width="1" Margin="10,10" VerticalAlignment="Stretch"
                                  Fill="{DynamicResource Brush.EdgeHi}" />
                        <Button Style="{StaticResource Button.Window}" Click="OnMinimise"
                                ToolTip="Minimise" AutomationProperties.Name="Minimise">
                            <Path Data="M0,5 H10" Stroke="{Binding Foreground,
                                  RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Width="11" Height="11" Stretch="None" />
                        </Button>
                        <Button Style="{StaticResource Button.Window}" Click="OnMaximise"
                                ToolTip="Maximise" AutomationProperties.Name="Maximise">
                            <Rectangle Width="9" Height="9" StrokeThickness="1"
                                       Stroke="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource Button.WindowClose}" Click="OnClose"
                                ToolTip="Close" AutomationProperties.Name="Close">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1"
                                  Stroke="{Binding Foreground,
                                  RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="11" Height="11" Stretch="None" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== panel face ==================== -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />

            <!-- ==================== tool rail ==================== -->
            <Border Grid.Row="2" Background="{DynamicResource Brush.Rail}"
                    BorderBrush="{DynamicResource Brush.EdgeHi}" BorderThickness="0,1,0,0"
                    Padding="18,12" DataContext="{Binding Tools}">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="SCREEN TOOLS"
                               Style="{StaticResource Text.Engraved}"
                               VerticalAlignment="Center" Margin="0,0,15,0" />

                    <Button DockPanel.Dock="Left" Style="{StaticResource Button.Tool}"
                            Margin="0,0,11,0"
                            ToolTip="Drag a region, then annotate it"
                            Command="{Binding CaptureRegionCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="REGION" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Chip.Key}" Margin="8,0,0,0"
                                    BorderThickness="1,0,0,0" CornerRadius="0" Padding="8,0,0,0">
                                <TextBlock Text="Ctrl ⇧ 2" Style="{StaticResource Text.Mono}"
                                           FontSize="12" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button DockPanel.Dock="Left" Style="{StaticResource Button.Tool}"
                            Content="WINDOW" Margin="0,0,11,0"
                            ToolTip="Pick a window to capture"
                            Command="{Binding CaptureWindowCommand}" />

                    <Button DockPanel.Dock="Left" Style="{StaticResource Button.Tool}"
                            Content="COLOUR" Margin="0,0,11,0"
                            ToolTip="Pick any pixel on screen; the hex is copied for you"
                            Command="{Binding PickColorCommand}" />

                    <Button DockPanel.Dock="Left" Style="{StaticResource Button.Tool}"
                            Content="RULER" Margin="0,0,11,0"
                            ToolTip="Measure in real screen pixels"
                            Command="{Binding ShowRulerCommand}" />

                    <Button DockPanel.Dock="Left" Style="{StaticResource Button.Tool}"
                            Content="{Binding PinStatus}" MinWidth="150" Margin="0,0,15,0"
                            ToolTip="Force a window to stay above everything"
                            Command="{Binding ShowPinPickerCommand}" />

                    <!-- last ten colours; click one to copy it again -->
                    <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding RecentColors}"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="22" Height="22" Margin="0,0,5,0" Cursor="Hand"
                                        ToolTip="{Binding}"
                                        Command="{Binding DataContext.CopyColorCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Chip" CornerRadius="2"
                                                    Background="{Binding}"
                                                    BorderBrush="{DynamicResource Brush.EdgeHi}"
                                                    BorderThickness="1" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chip" Property="BorderBrush"
                                                            Value="{DynamicResource Brush.Prime}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button DockPanel.Dock="Left" Style="{StaticResource Button.Icon}"
                            ToolTip="Clear the swatch strip" Margin="4,0,0,0"
                            Visibility="{Binding CanClearColors, Converter={StaticResource BoolToVisible}}"
                            Command="{Binding ClearColorsCommand}">
                        <Path Style="{StaticResource Glyph}" Data="{StaticResource Geo.Close}" />
                    </Button>


                    <TextBlock DockPanel.Dock="Right" Text="{Binding LastHex}"
                               Style="{StaticResource Text.Status}"
                               Foreground="{DynamicResource Brush.Prime}" />
                </DockPanel>
            </Border>

            <!-- ==================== status bar ==================== -->
            <Border Grid.Row="3" Background="{DynamicResource Brush.Titlebar}"
                    BorderBrush="{DynamicResource Brush.EdgeFaint}" BorderThickness="0,1,0,0"
                    Padding="16,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.LampOn}"
                                 VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="8"
                                                  Color="{DynamicResource Color.LampOn}"
                                                  Opacity="0.8" />
                            </Ellipse.Effect>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.4" Duration="0:0:1"
                                                             AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Status}"
                                   Foreground="{DynamicResource Brush.LampOn}" Margin="7,0,0,0" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusHint}"
                               Style="{StaticResource Text.Status}" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
