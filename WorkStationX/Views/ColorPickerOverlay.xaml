<Window x:Class="WorkStationX.Views.ColorPickerOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a colour"
        WindowStyle="None" ShowInTaskbar="False"
        Topmost="True" Cursor="Cross"
        AllowsTransparency="False"
        Background="Black">

    <!--
        Opaque, showing a frozen screenshot rather than being see-through.

        AllowsTransparency="True" forces WPF to software-render the entire window;
        at full-screen size that made the picker crawl. An opaque window stays on the
        GPU, and sampling a captured bitmap in memory is far cheaper than asking the
        driver for a pixel on every mouse move.
    -->
    <Canvas x:Name="Root" ClipToBounds="True">
        <Image x:Name="Frozen" Canvas.Left="0" Canvas.Top="0"
               RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <Border x:Name="Readout" Canvas.Left="0" Canvas.Top="0"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Prime}" BorderThickness="1"
                Padding="14,12" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <!-- magnifier: the captured image scaled up around the cursor -->
                <Border Width="96" Height="96" ClipToBounds="True"
                        BorderBrush="{DynamicResource Brush.EdgeHi}" BorderThickness="1">
                    <Grid>
                        <Image x:Name="Zoom" RenderOptions.BitmapScalingMode="NearestNeighbor"
                               Stretch="None" />
                        <Rectangle Width="9" Height="9" Stroke="{DynamicResource Brush.Prime}"
                                   StrokeThickness="1"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border x:Name="Swatch" Height="26" Width="150"
                            BorderBrush="{DynamicResource Brush.EdgeHi}" BorderThickness="1" />
                    <TextBlock x:Name="HexText" Text="#000000" Margin="0,7,0,0"
                               FontFamily="{StaticResource Font.Mono}" FontSize="21"
                               Foreground="{DynamicResource Brush.Phos}" />
                    <TextBlock x:Name="RgbText" Text="rgb(0, 0, 0)" Margin="0,3,0,0"
                               Style="{StaticResource Text.Mono}" />
                    <TextBlock Text="Click to copy · Esc to cancel" Margin="0,7,0,0"
                               Style="{StaticResource Text.EngravedSmall}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
