<UserControl x:Class="WorkStationX.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WorkStationX.Views">

    <UserControl.Resources>
        <views:LevelToBrushConverter x:Key="LevelToBrush" />

        <!-- One square. Level drives the fill; future days are left blank. -->
        <DataTemplate x:Key="DayCellTemplate">
            <Border Width="13" Height="13" Margin="0,0,3,3" CornerRadius="2"
                    Background="{Binding Level, Converter={StaticResource LevelToBrush}}"
                    ToolTip="{Binding Tooltip}"
                    Visibility="{Binding IsFuture, Converter={StaticResource FalseToVisible}}" />
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.BayFace}" Padding="32,26">
        <DockPanel>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="HISTORY" Style="{StaticResource Text.Engraved}" />
                <Rectangle Grid.Column="1" Style="{StaticResource Panel.HeadRule}" Margin="10,0,0,0" />
            </Grid>

            <!-- contribution grid -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Panel.Plate}" Padding="18,16">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="{Binding Headline}" HorizontalAlignment="Left"
                                   Style="{StaticResource Text.Title}" FontSize="16.5" />
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Style="{StaticResource Text.Mono}"
                                   Text="Hover a square to see that day" />
                    </Grid>

                    <!-- legend -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,12,0,0">
                        <TextBlock Text="Less" Style="{StaticResource Text.Mono}"
                                   VerticalAlignment="Center" Margin="0,0,7,0" />
                        <Border Width="13" Height="13" CornerRadius="2" Margin="0,0,3,0"
                                Background="{Binding Converter={StaticResource LevelToBrush},
                                             ConverterParameter=0}" />
                        <Border Width="13" Height="13" CornerRadius="2" Margin="0,0,3,0"
                                Background="{Binding Converter={StaticResource LevelToBrush},
                                             ConverterParameter=1}" />
                        <Border Width="13" Height="13" CornerRadius="2" Margin="0,0,3,0"
                                Background="{Binding Converter={StaticResource LevelToBrush},
                                             ConverterParameter=2}" />
                        <Border Width="13" Height="13" CornerRadius="2" Margin="0,0,3,0"
                                Background="{Binding Converter={StaticResource LevelToBrush},
                                             ConverterParameter=3}" />
                        <Border Width="13" Height="13" CornerRadius="2" Margin="0,0,7,0"
                                Background="{Binding Converter={StaticResource LevelToBrush},
                                             ConverterParameter=4}" />
                        <TextBlock Text="More" Style="{StaticResource Text.Mono}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <!-- day-of-week gutter; only alternate rows are labelled,
                                 exactly as a contribution graph does -->
                            <StackPanel Margin="0,0,8,0" VerticalAlignment="Top">
                                <TextBlock Height="16" Text="" />
                                <TextBlock Height="16" Text="Mon" Style="{StaticResource Text.Mono}" />
                                <TextBlock Height="16" Text="" />
                                <TextBlock Height="16" Text="Wed" Style="{StaticResource Text.Mono}" />
                                <TextBlock Height="16" Text="" />
                                <TextBlock Height="16" Text="Fri" Style="{StaticResource Text.Mono}" />
                                <TextBlock Height="16" Text="" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Weeks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Days}"
                                                      ItemTemplate="{StaticResource DayCellTemplate}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- summary figures -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Panel.Plate}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TIME TRACKED" Style="{StaticResource Text.EngravedSmall}" />
                        <TextBlock Text="{Binding TotalWorkedText}" Margin="0,4,0,0"
                                   FontFamily="{StaticResource Font.Mono}" FontSize="24"
                                   Foreground="{DynamicResource Brush.Phos}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="CURRENT STREAK" Style="{StaticResource Text.EngravedSmall}" />
                        <TextBlock Text="{Binding StreakText}" Margin="0,4,0,0"
                                   FontFamily="{StaticResource Font.Mono}" FontSize="24"
                                   Foreground="{DynamicResource Brush.LampOn}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="BEST DAY" Style="{StaticResource Text.EngravedSmall}" />
                        <TextBlock Text="{Binding BestDayText}" Margin="0,4,0,0"
                                   FontFamily="{StaticResource Font.Mono}" FontSize="24"
                                   Foreground="{DynamicResource Brush.Prime}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid />
        </DockPanel>
    </Border>
</UserControl>
