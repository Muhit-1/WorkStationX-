<Window x:Class="WorkStationX.Views.WorkspaceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workspace"
        Height="620" Width="700"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.Shell}">

    <Border Background="{DynamicResource Brush.BayFace}"
            BorderBrush="{DynamicResource Brush.EdgeWindow}" BorderThickness="1"
            Padding="24,20">
        <DockPanel>

            <!-- head -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding HeaderText}"
                           Style="{StaticResource Text.Engraved}" />
                <Rectangle Grid.Column="1" Style="{StaticResource Panel.HeadRule}" Margin="10,0,0,0" />
            </Grid>

            <!-- name -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="NAME" Style="{StaticResource Text.EngravedSmall}" Margin="0,0,0,6" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource Input.Text}" />
            </StackPanel>

            <!-- add row -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Panel.Plate}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="ADD TO THIS WORKSPACE"
                               Style="{StaticResource Text.EngravedSmall}" Margin="0,0,0,9" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Style="{StaticResource Input.Text}"
                                 Text="{Binding NewUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="github.com"
                                 VerticalAlignment="Center" />

                        <ComboBox Grid.Column="1" Margin="8,0,0,0" Width="150"
                                  Style="{StaticResource Input.Combo}"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding NewUrlProfile}"
                                  DisplayMemberPath="FriendlyName"
                                  ToolTip="Chrome profile this site opens in" />

                        <Button Grid.Column="2" Margin="8,0,0,0" Content="ADD SITE"
                                Style="{StaticResource Button.Tool}"
                                Command="{Binding AddUrlCommand}" />

                        <Button Grid.Column="3" Margin="8,0,0,0" Content="ADD APP…"
                                Style="{StaticResource Button.Tool}"
                                Command="{Binding AddAppCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding Error}" Margin="0,9,0,0"
                               Foreground="{DynamicResource Brush.LampRed}"
                               Style="{StaticResource Text.Mono}"
                               Visibility="{Binding Error,
                                            Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </Border>

            <!-- buttons -->
            <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Style="{StaticResource Text.Mono}"
                           Text="Items launch top to bottom." />
                <Button Grid.Column="1" Content="CANCEL" Width="130"
                        Style="{StaticResource Button.Transport}" Click="OnCancel" />
                <Button Grid.Column="2" Content="SAVE" Width="150" Margin="11,0,0,0"
                        Style="{StaticResource Button.Prime}" Click="OnSave" IsDefault="True" />
            </Grid>

            <!-- item list -->
            <Border BorderBrush="{DynamicResource Brush.EdgeLo}" BorderThickness="1">
                <Grid>
                    <TextBlock Style="{StaticResource Text.Note}" TextAlignment="Center"
                               VerticalAlignment="Center" Margin="20"
                               Text="Nothing here yet.&#x0a;Add the apps and websites this context needs."
                               Visibility="{Binding Items.Count,
                                            Converter={StaticResource ZeroToVisible}}" />

                    <ListBox ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem}"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Face" Background="Transparent"
                                                    BorderBrush="{DynamicResource Brush.EdgeFaint}"
                                                    BorderThickness="0,0,0,1" Padding="12,10">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Face" Property="Background"
                                                            Value="{DynamicResource Brush.HoverWash}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Face" Property="Background"
                                                            Value="{DynamicResource Brush.HoverWash}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0" Width="20" Height="20"
                                           Margin="0,0,11,0" VerticalAlignment="Center"
                                           Source="{Binding Icon}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Style="{StaticResource Text.Title}" />
                                            <TextBlock Text="MISSING" Margin="9,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource Text.EngravedSmall}"
                                                       Foreground="{DynamicResource Brush.LampRed}"
                                                       Visibility="{Binding IsBroken,
                                                                    Converter={StaticResource BoolToVisible}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Target}"
                                                   Style="{StaticResource Text.Mono}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <ComboBox Grid.Column="2" Width="140" Margin="0,0,8,0"
                                              Style="{StaticResource Input.Combo}"
                                              VerticalAlignment="Center"
                                              ItemsSource="{Binding DataContext.Profiles,
                                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                              SelectedItem="{Binding ChromeProfile}"
                                              DisplayMemberPath="FriendlyName"
                                              Visibility="{Binding IsWebsite,
                                                           Converter={StaticResource BoolToVisible}}" />

                                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource Button.Icon}" ToolTip="Move up"
                                                        Command="{Binding DataContext.MoveUpCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Style="{StaticResource Glyph}" Data="{StaticResource Geo.Up}" />
                                                </Button>
                                        <Button Margin="5,0,0,0" Style="{StaticResource Button.Icon}" ToolTip="Move down"
                                                        Command="{Binding DataContext.MoveDownCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Style="{StaticResource Glyph}" Data="{StaticResource Geo.Down}" />
                                                </Button>
                                        <Button Margin="5,0,0,0" Style="{StaticResource Button.IconDanger}" ToolTip="Remove"
                                                        Command="{Binding DataContext.RemoveCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Style="{StaticResource Glyph}" Data="{StaticResource Geo.Close}" />
                                                </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </DockPanel>
    </Border>
</Window>
