<Window x:Class="WorkStationX.Views.WindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WorkStationX.Views"
        Title="Pin on top"
        Width="620" Height="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Shell}">

    <Border Background="{DynamicResource Brush.BayFace}"
            BorderBrush="{DynamicResource Brush.EdgeWindow}" BorderThickness="1"
            Padding="22,18">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="PIN ON TOP" Style="{StaticResource Text.Engraved}" />
                <Rectangle Grid.Column="1" Style="{StaticResource Panel.HeadRule}" Margin="10,0" />
                <TextBlock Grid.Column="2" Text="{Binding PinnedCount}"
                           Style="{StaticResource Text.Mono}" />
            </Grid>

            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Note}" Margin="0,0,0,14"
                       Text="A pinned window floats above everything until you unpin it. Pins are released automatically when WorkStationX closes." />

            <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Button Content="UNPIN ALL" HorizontalAlignment="Left"
                        Style="{StaticResource Button.Tool}" Padding="16,10"
                        Command="{Binding UnpinAllCommand}" />
                <Button Content="DONE" HorizontalAlignment="Right" Width="130"
                        Style="{StaticResource Button.Prime}" Padding="10,10"
                        Click="OnDone" IsDefault="True" />
            </Grid>

            <Border BorderBrush="{DynamicResource Brush.EdgeLo}" BorderThickness="1">
                <ListBox ItemsSource="{Binding Windows}" Background="Transparent"
                         BorderThickness="0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Face" Background="Transparent"
                                                BorderBrush="{DynamicResource Brush.EdgeFaint}"
                                                BorderThickness="0,0,0,1" Padding="12,10">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Face" Property="Background"
                                                        Value="{DynamicResource Brush.HoverWash}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource Lamp}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                    <Setter Property="Fill"
                                                            Value="{DynamicResource Brush.LampOn}" />
                                                    <Setter Property="Stroke" Value="Transparent" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource Text.Title}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ProcessName}"
                                               Style="{StaticResource Text.Mono}" Margin="0,2,0,0" />
                                </StackPanel>

                                <Button Grid.Column="2" Style="{StaticResource Button.Tool}"
                                        Padding="14,8" VerticalAlignment="Center"
                                        Command="{Binding DataContext.TogglePinCommand,
                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <Binding Path="IsPinned">
                                                <Binding.Converter>
                                                    <views:BoolToTextConverter TrueText="UNPIN"
                                                                               FalseText="PIN" />
                                                </Binding.Converter>
                                            </Binding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>
    </Border>
</Window>
