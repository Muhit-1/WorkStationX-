<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- BENCH - AMBER. Neutral graphite carcass, warm amber action.
         Same key set as DarkGreen.xaml. Every palette must define all of them. -->

    <system:String xmlns:system="clr-namespace:System;assembly=System.Runtime"
                   x:Key="Palette.Name">Bench — Amber</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=System.Runtime"
                   x:Key="Palette.Id">graphite</system:String>

    <Color x:Key="Color.Shell">#0A0A0B</Color>
    <Color x:Key="Color.Panel">#212226</Color>
    <Color x:Key="Color.PanelHi">#2B2C31</Color>
    <Color x:Key="Color.PanelLo">#171719</Color>
    <Color x:Key="Color.Well">#08080A</Color>
    <Color x:Key="Color.Titlebar">#111113</Color>

    <SolidColorBrush x:Key="Brush.Shell" Color="{DynamicResource Color.Shell}" />
    <SolidColorBrush x:Key="Brush.Panel" Color="{DynamicResource Color.Panel}" />
    <SolidColorBrush x:Key="Brush.PanelHi" Color="{DynamicResource Color.PanelHi}" />
    <SolidColorBrush x:Key="Brush.PanelLo" Color="{DynamicResource Color.PanelLo}" />
    <SolidColorBrush x:Key="Brush.Well" Color="{DynamicResource Color.Well}" />
    <SolidColorBrush x:Key="Brush.Titlebar" Color="{DynamicResource Color.Titlebar}" />

    <Color x:Key="Color.Phos">#E4E2DC</Color>
    <Color x:Key="Color.Engrave">#C3BFB6</Color>
    <Color x:Key="Color.EngraveDim">#AFABA2</Color>
    <Color x:Key="Color.TextBright">#EFEDE7</Color>
    <Color x:Key="Color.TextMono">#C9C5BC</Color>
    <Color x:Key="Color.TextLog">#DEDBD4</Color>
    <Color x:Key="Color.ReadoutDim">#AFAAA0</Color>

    <SolidColorBrush x:Key="Brush.Phos" Color="{DynamicResource Color.Phos}" />
    <SolidColorBrush x:Key="Brush.Engrave" Color="{DynamicResource Color.Engrave}" />
    <SolidColorBrush x:Key="Brush.EngraveDim" Color="{DynamicResource Color.EngraveDim}" />
    <SolidColorBrush x:Key="Brush.TextBright" Color="{DynamicResource Color.TextBright}" />
    <SolidColorBrush x:Key="Brush.TextMono" Color="{DynamicResource Color.TextMono}" />
    <SolidColorBrush x:Key="Brush.TextLog" Color="{DynamicResource Color.TextLog}" />
    <SolidColorBrush x:Key="Brush.ReadoutDim" Color="{DynamicResource Color.ReadoutDim}" />

    <Color x:Key="Color.EdgeHi">#1CE0DCD2</Color>
    <Color x:Key="Color.EdgeLo">#8C000000</Color>
    <Color x:Key="Color.EdgeFaint">#0FE0DCD2</Color>
    <Color x:Key="Color.EdgeWindow">#21E0DCD2</Color>
    <Color x:Key="Color.HoverWash">#0AE0DCD2</Color>

    <SolidColorBrush x:Key="Brush.EdgeHi" Color="{DynamicResource Color.EdgeHi}" />
    <SolidColorBrush x:Key="Brush.EdgeLo" Color="{DynamicResource Color.EdgeLo}" />
    <SolidColorBrush x:Key="Brush.EdgeFaint" Color="{DynamicResource Color.EdgeFaint}" />
    <SolidColorBrush x:Key="Brush.EdgeWindow" Color="{DynamicResource Color.EdgeWindow}" />
    <SolidColorBrush x:Key="Brush.HoverWash" Color="{DynamicResource Color.HoverWash}" />

    <Color x:Key="Color.Prime">#E8A33D</Color>
    <Color x:Key="Color.PrimeHi">#F5BC5F</Color>
    <Color x:Key="Color.PrimeLo">#C7842A</Color>
    <Color x:Key="Color.PrimeEdge">#6B4413</Color>
    <Color x:Key="Color.OnPrime">#1C1205</Color>
    <Color x:Key="Color.Focus">#F5BC5F</Color>
    <Color x:Key="Color.LampOn">#9BD46A</Color>
    <Color x:Key="Color.LampOff">#131315</Color>
    <Color x:Key="Color.LampRed">#EE6E55</Color>
    <Color x:Key="Color.ReadoutOver">#F5A88F</Color>
    <Color x:Key="Color.CloseHover">#B03A20</Color>

    <SolidColorBrush x:Key="Brush.Prime" Color="{DynamicResource Color.Prime}" />
    <SolidColorBrush x:Key="Brush.PrimeHi" Color="{DynamicResource Color.PrimeHi}" />
    <SolidColorBrush x:Key="Brush.PrimeLo" Color="{DynamicResource Color.PrimeLo}" />
    <SolidColorBrush x:Key="Brush.PrimeEdge" Color="{DynamicResource Color.PrimeEdge}" />
    <SolidColorBrush x:Key="Brush.OnPrime" Color="{DynamicResource Color.OnPrime}" />
    <SolidColorBrush x:Key="Brush.Focus" Color="{DynamicResource Color.Focus}" />
    <SolidColorBrush x:Key="Brush.LampOn" Color="{DynamicResource Color.LampOn}" />
    <SolidColorBrush x:Key="Brush.LampOff" Color="{DynamicResource Color.LampOff}" />
    <SolidColorBrush x:Key="Brush.LampRed" Color="{DynamicResource Color.LampRed}" />
    <SolidColorBrush x:Key="Brush.ReadoutOver" Color="{DynamicResource Color.ReadoutOver}" />
    <SolidColorBrush x:Key="Brush.CloseHover" Color="{DynamicResource Color.CloseHover}" />

    <Color x:Key="Color.SwitchTop">#2A2B30</Color>
    <Color x:Key="Color.SwitchBottom">#1D1E21</Color>
    <Color x:Key="Color.SwitchHoverTop">#35363C</Color>
    <Color x:Key="Color.SwitchHoverBottom">#242528</Color>
    <Color x:Key="Color.SwitchOnTop">#32333A</Color>
    <Color x:Key="Color.SwitchOnBottom">#212226</Color>

    <Color x:Key="Color.PlateTop">#27282C</Color>
    <Color x:Key="Color.PlateBottom">#191A1D</Color>
    <Color x:Key="Color.PlateHoverTop">#303136</Color>
    <Color x:Key="Color.PlateHoverBottom">#212226</Color>

    <Color x:Key="Color.ButtonTop">#34353B</Color>
    <Color x:Key="Color.ButtonBottom">#222327</Color>
    <Color x:Key="Color.ButtonHoverTop">#414249</Color>
    <Color x:Key="Color.ButtonHoverBottom">#2B2C31</Color>

    <Color x:Key="Color.ToolTop">#2F3035</Color>
    <Color x:Key="Color.ToolBottom">#1F2023</Color>
    <Color x:Key="Color.ToolHoverTop">#3C3D43</Color>
    <Color x:Key="Color.ToolHoverBottom">#28292E</Color>

    <Color x:Key="Color.RailTop">#232428</Color>
    <Color x:Key="Color.RailBottom">#141416</Color>

    <Color x:Key="Color.ScaleTrack">#121214</Color>
    <Color x:Key="Color.ScaleFill">#7FAF52</Color>

    <Color x:Key="Color.ScrewLight">#55565C</Color>
    <Color x:Key="Color.ScrewDark">#131315</Color>

    <LinearGradientBrush x:Key="Brush.BayFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource Color.PanelHi}" Offset="0" />
        <GradientStop Color="{DynamicResource Color.Panel}" Offset="0.14" />
        <GradientStop Color="{DynamicResource Color.PanelLo}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Switch" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource Color.SwitchTop}" Offset="0" />
        <GradientStop Color="{DynamicResource Color.SwitchBottom}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.SwitchHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource Color.SwitchHoverTop}" Offset="0" />
        <GradientStop Color="{DynamicResource Color.SwitchHoverBottom}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.SwitchOn" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource Color.SwitchOnTop}" Offset="0" />
        <GradientStop Color="{DynamicResource Color.SwitchOnBottom}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Plate" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource Color.PlateTop}" Offset="0" />
        <GradientStop Color="{DynamicResource Color.PlateBottom}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.PlateHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource Color.PlateHoverTop}" Offset="0" />
        <GradientStop Color="{DynamicResource Color.PlateHoverBottom}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Button" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource Color.ButtonTop}" Offset="0" />
        <GradientStop Color="{DynamicResource Color.ButtonBottom}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ButtonHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource Color.ButtonHoverTop}" Offset="0" />
        <GradientStop Color="{DynamicResource Color.ButtonHoverBottom}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ButtonPrime" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource Color.PrimeHi}" Offset="0" />
        <GradientStop Color="{DynamicResource Color.PrimeLo}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Tool" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource Color.ToolTop}" Offset="0" />
        <GradientStop Color="{DynamicResource Color.ToolBottom}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ToolHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource Color.ToolHoverTop}" Offset="0" />
        <GradientStop Color="{DynamicResource Color.ToolHoverBottom}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Rail" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource Color.RailTop}" Offset="0" />
        <GradientStop Color="{DynamicResource Color.RailBottom}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ScaleFill" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{DynamicResource Color.ScaleFill}" Offset="0" />
        <GradientStop Color="{DynamicResource Color.LampOn}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.ScaleTrack" Color="{DynamicResource Color.ScaleTrack}" />
    <RadialGradientBrush x:Key="Brush.Screw" GradientOrigin="0.35,0.3" Center="0.35,0.3"
                         RadiusX="0.75" RadiusY="0.75">
        <GradientStop Color="{DynamicResource Color.ScrewLight}" Offset="0" />
        <GradientStop Color="{DynamicResource Color.ScrewDark}" Offset="0.7" />
    </RadialGradientBrush>

</ResourceDictionary>
