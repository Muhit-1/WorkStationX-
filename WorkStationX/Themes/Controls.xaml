<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:WorkStationX.Views">

    <!--
        Instrument-panel controls. Every colour here is a DynamicResource so
        ThemeService can swap the palette dictionary at runtime.
    -->

    <views:BoolToVisibilityConverter x:Key="BoolToVisible" />
    <views:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <views:ZeroToVisibleConverter x:Key="ZeroToVisible" />
    <views:NonZeroToVisibleConverter x:Key="NonZeroToVisible" />
    <views:FractionToStarConverter x:Key="FractionToStar" />
    <views:InverseFractionToStarConverter x:Key="InverseFractionToStar" />
    <views:FalseToVisibleConverter x:Key="FalseToVisible" />
    <views:DoneToOpacityConverter x:Key="DoneToOpacity" />

    <!-- ================= bay panel ================= -->
    <!-- The anodised face with a lit top edge and two recessed corner screws. -->
    <Style x:Key="Panel.Bay" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.BayFace}" />
        <Setter Property="Padding" Value="18,18,18,16" />
    </Style>

    <Style x:Key="Panel.Screw" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Fill" Value="{DynamicResource Brush.Screw}" />
        <Setter Property="Stroke" Value="{DynamicResource Brush.EdgeLo}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <!-- The hairline that runs from a bay heading to its index number -->
    <Style x:Key="Panel.HeadRule" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{DynamicResource Color.EdgeHi}" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= recessed well ================= -->
    <!-- Where readouts sit. Near-black with an inner shadow and a lit bottom lip. -->
    <Style x:Key="Panel.Well" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Well}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.EdgeLo}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="22,20,22,18" />
    </Style>

    <!-- Engraved data plate, a step up from the well -->
    <Style x:Key="Panel.Plate" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Plate}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.EdgeHi}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="15,13" />
    </Style>

    <!-- ================= indicator lamp ================= -->
    <!-- Off is a dead recessed bulb; on glows. The glow is what tells the user
         a workspace is still open at a glance. -->
    <Style x:Key="Lamp" TargetType="Ellipse">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="Fill" Value="{DynamicResource Brush.LampOff}" />
        <Setter Property="Stroke" Value="{DynamicResource Brush.EdgeHi}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style x:Key="Lamp.On" TargetType="Ellipse" BasedOn="{StaticResource Lamp}">
        <Setter Property="Fill" Value="{DynamicResource Brush.LampOn}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0" BlurRadius="10"
                                  Color="{DynamicResource Color.LampOn}" Opacity="0.75" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= focus ring ================= -->
    <Style x:Key="FocusRing" TargetType="Control">
        <Setter Property="FocusVisualStyle">
            <Setter.Value>
                <Style>
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <Rectangle Margin="-2" StrokeThickness="2"
                                           Stroke="{DynamicResource Brush.Focus}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= transport button ================= -->
    <!-- The chunky PAUSE / POST TO BANK pair. Presses down 2px on click. -->
    <Style x:Key="Button.Transport" TargetType="Button" BasedOn="{StaticResource FocusRing}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Cond}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextBright}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Button}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.EdgeLo}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="10,14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- the 2px shadow the button sinks into -->
                        <Border x:Name="Sink" CornerRadius="3" Margin="0,2,0,0"
                                Background="{DynamicResource Brush.EdgeLo}" />
                        <Border x:Name="Face" CornerRadius="3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Margin="0,0,0,2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background"
                                    Value="{DynamicResource Brush.ButtonHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Margin" Value="0,2,0,0" />
                            <Setter TargetName="Sink" Property="Opacity" Value="0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The one accent action per screen. It needs its own template rather than
        inheriting Transport's: Transport's hover trigger repaints the face with the
        ordinary grey button brush, which turned the accent button grey the moment the
        pointer touched it. Here hover brightens instead, and the disabled state stays
        legible rather than fading to 45%.
    -->
    <Style x:Key="Button.Prime" TargetType="Button" BasedOn="{StaticResource FocusRing}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Cond}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrime}" />
        <Setter Property="Background" Value="{DynamicResource Brush.ButtonPrime}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimeEdge}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="10,14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Sink" CornerRadius="3" Margin="0,2,0,0"
                                Background="{DynamicResource Brush.EdgeLo}" />
                        <Border x:Name="Face" CornerRadius="3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" Margin="0,0,0,2">
                            <ContentPresenter x:Name="Label"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Margin" Value="0,2,0,0" />
                            <Setter TargetName="Sink" Property="Opacity" Value="0" />
                        </Trigger>
                        <!-- Disabled reads as an outline, not a ghost: the user can still
                             see what the action is called. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Background" Value="Transparent" />
                            <Setter TargetName="Face" Property="BorderBrush"
                                    Value="{DynamicResource Brush.PrimeEdge}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.EngraveDim}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= tool rail button ================= -->
    <Style x:Key="Button.Tool" TargetType="Button" BasedOn="{StaticResource FocusRing}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Cond}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMono}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Tool}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" CornerRadius="3"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Brush.EdgeLo}"
                            BorderThickness="1">
                        <ContentPresenter VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background"
                                    Value="{DynamicResource Brush.ToolHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Phos}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= dropdown ================= -->
    <!-- The stock WPF ComboBox is white-on-blue Windows chrome and looked pasted in.
         This is the recessed slot from Input.Text with a themed popup list. -->
    <Style x:Key="Input.Combo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextBright}" />
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Face" CornerRadius="2"
                                            Background="{DynamicResource Brush.Well}"
                                            BorderBrush="{DynamicResource Brush.EdgeLo}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1" Margin="0,0,11,0"
                                                  Data="M0,0 L5,5 L10,0" Width="11" Height="6"
                                                  Stretch="None" StrokeThickness="1.6"
                                                  Stroke="{DynamicResource Brush.Engrave}"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Face" Property="BorderBrush"
                                                    Value="{DynamicResource Brush.EdgeWindow}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Face" Property="BorderBrush"
                                                    Value="{DynamicResource Brush.Prime}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>

                        </ToggleButton>

                        <!-- The selected value is drawn OUTSIDE the ToggleButton. It used
                             to be the button.s Content, which meant a ContentPresenter
                             nested inside another one - and that renders nothing, so the
                             box looked permanently empty. -->
                        <ContentPresenter IsHitTestVisible="False"
                                          Margin="11,8,34,8" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />

                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Slide">
                            <Border MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource Brush.Panel}"
                                    BorderBrush="{DynamicResource Brush.Prime}"
                                    BorderThickness="1" Margin="0,3,0,0">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Phos}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Row" Background="Transparent" Padding="11,8">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background"
                                                Value="{DynamicResource Brush.HoverWash}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Row" Property="Background"
                                                Value="{DynamicResource Brush.ButtonPrime}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource Brush.OnPrime}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= tool selector ================= -->
    <!-- Radio behaviour with the look of a rail button, for the annotation toolbar. -->
    <Style x:Key="Toggle.Tool" TargetType="RadioButton" BasedOn="{StaticResource FocusRing}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Cond}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMono}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="66" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Face" CornerRadius="3" Padding="13,8"
                            Background="{DynamicResource Brush.Tool}"
                            BorderBrush="{DynamicResource Brush.EdgeLo}"
                            BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background"
                                    Value="{DynamicResource Brush.ToolHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background"
                                    Value="{DynamicResource Brush.ButtonPrime}" />
                            <Setter TargetName="Face" Property="BorderBrush"
                                    Value="{DynamicResource Brush.PrimeEdge}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrime}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= square icon button =================
         Fixed square, vector content. The X and arrows used to be text glyphs, which
         Archivo Narrow does not carry - so they fell back to a different face at a
         different size and the row looked broken. Geometry has no such dependency. -->
    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource FocusRing}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMono}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Tool}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" CornerRadius="3"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Brush.EdgeLo}"
                            BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background"
                                    Value="{DynamicResource Brush.ToolHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Phos}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger variant: delete goes red on hover so it reads before it is clicked. -->
    <Style x:Key="Button.IconDanger" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" CornerRadius="3"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Brush.EdgeLo}"
                            BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background"
                                    Value="{DynamicResource Brush.CloseHover}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vector glyphs, sized to the icon button. -->
    <Style x:Key="Glyph" TargetType="Path">
        <Setter Property="Stroke" Value="{Binding Foreground,
                RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Width" Value="11" />
        <Setter Property="Height" Value="11" />
        <Setter Property="Stretch" Value="None" />
    </Style>

    <Geometry x:Key="Geo.Close">M0,0 L10,10 M10,0 L0,10</Geometry>
    <Geometry x:Key="Geo.Up">M1,7 L5.5,2.5 L10,7</Geometry>
    <Geometry x:Key="Geo.Down">M1,3.5 L5.5,8 L10,3.5</Geometry>

    <!-- ================= dashed "new" button ================= -->
    <Style x:Key="Button.New" TargetType="Button" BasedOn="{StaticResource FocusRing}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Cond}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Engrave}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" CornerRadius="2"
                            Background="Transparent"
                            BorderBrush="{DynamicResource Brush.EdgeWindow}"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border" />
                        </Border.Style>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background"
                                    Value="{DynamicResource Brush.HoverWash}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Phos}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= workspace switch ================= -->
    <!-- A ToggleButton, because a workspace really is on or off: lit means its
         apps are open, and flipping it off closes that set. -->
    <Style x:Key="Switch.Workspace" TargetType="ToggleButton" BasedOn="{StaticResource FocusRing}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Face"
                            Background="{DynamicResource Brush.Switch}"
                            BorderBrush="Transparent"
                            BorderThickness="2,0,0,0"
                            Padding="12,13">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background"
                                    Value="{DynamicResource Brush.SwitchHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background"
                                    Value="{DynamicResource Brush.SwitchOn}" />
                            <Setter TargetName="Face" Property="BorderBrush"
                                    Value="{DynamicResource Brush.LampOn}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Keyboard shortcut chip, e.g. "Alt 1" -->
    <Style x:Key="Chip.Key" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.EdgeHi}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="5,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ================= titlebar button ================= -->
    <Style x:Key="Button.Window" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="37" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.EngraveDim}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background"
                                    Value="{DynamicResource Brush.HoverWash}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Phos}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.WindowClose" TargetType="Button" BasedOn="{StaticResource Button.Window}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background"
                                    Value="{DynamicResource Brush.CloseHover}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= text input ================= -->
    <!-- A recessed slot, matching the readout wells rather than a stock WPF box. -->
    <Style x:Key="Input.Text" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextBright}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Prime}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Prime}" />
        <Setter Property="Padding" Value="11,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Face" CornerRadius="2"
                            Background="{DynamicResource Brush.Well}"
                            BorderBrush="{DynamicResource Brush.EdgeLo}"
                            BorderThickness="1">
                        <Grid>
                            <!-- Placeholder. Deliberately faint: it is a hint, not content,
                                 and it shares the same colour token as real labels. -->
                            <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Foreground="{DynamicResource Brush.EngraveDim}"
                                       Opacity="0.45"
                                       Visibility="Collapsed" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Empty AND unfocused. Showing the hint while focused drew it
                             over the caret, so the cursor appeared mid-word. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value="" />
                                <Condition Property="IsKeyboardFocused" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Prime}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= progress scale ================= -->
    <Style x:Key="Scale.Track" TargetType="Border">
        <Setter Property="Height" Value="9" />
        <Setter Property="Background" Value="{DynamicResource Brush.ScaleTrack}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.EdgeLo}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

</ResourceDictionary>
