<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WsxTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>WorkStationX</AssemblyName>
    <RootNamespace>WorkStationX</RootNamespace>

    <!-- Per-Monitor DPI Aware v2. Required for the screen ruler, colour picker
         and capture overlays to report correct physical pixels on mixed-DPI setups. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Shown in Explorer file properties and by the installer. -->
    <Version>1.0.0</Version>
    <Product>WorkStationX</Product>
    <Company>WorkStationX</Company>
    <Description>Workspace launcher, task timer and screen tools</Description>

    <!-- Publish settings: one self-contained folder, so the user installs nothing. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so the app carries its own typography; no user install needed. -->
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
  </ItemGroup>

</Project>
