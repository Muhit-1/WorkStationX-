<Project>

  <!--
    Single place to retarget the entire solution.
    The Windows SDK suffix is required for WinRT interop (toast notifications).
  -->
  <PropertyGroup>
    <WsxTargetFramework>net10.0-windows10.0.19041.0</WsxTargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
