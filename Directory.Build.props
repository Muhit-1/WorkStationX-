<Project>

  <!--
    Single place to retarget the entire solution.

    When the .NET 10 SDK is installed, change WsxTargetFramework to:
        net10.0-windows10.0.19041.0
    The Windows SDK suffix is required for WinRT interop (toast notifications).
    Nothing else in the solution needs to change.
  -->
  <PropertyGroup>
    <WsxTargetFramework>net8.0-windows</WsxTargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
